{
  "name": "saved-by-the-thread",
  "version": "0.1.0",
  "private": true,
  "description": "Saved by the Thread: a static guide to what babies' and kids' things are made of.",
  "scripts": {
    "check": "node tools/check.js",
    "test": "node --test \"tests/unit/*.test.js\"",
    "test:e2e": "node --test \"tests/e2e/*.test.js\"",
    "test:all": "npm run check && npm test && npm run test:e2e",
    "serve": "node tools/serve.js 8000",
    "bundle": "node tools/bundle.js dist",
    "test:visual": "node tools/visual.js",
    "test:visual:update": "node tools/visual.js --update-snapshots"
  },
  "devDependencies": {
    "@playwright/test": "1.56.1",
    "playwright": "1.56.1",
    "sharp": "0.35.5"
  },
  "engines": {
    "node": ">=22"
  }
}
